
@section Styles {
    <link rel="stylesheet" href="~/css/AboutPage.css" asp-append-version="true" />
}

<!-- HERO SECTION -->
<section class="uhm-hero">
    <div class="uhm-hero-overlay"></div>

    <div class="container uhm-hero-content text-center">
        <span class="uhm-eyebrow">
            <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M3 6l6-3 6 3 6-3v15l-6 3-6-3-6 3z"/>
                <path d="M9 3v15M15 6v15"/>
            </svg>
            URBANHAZARDMAP
        </span>

        <h1>Как работи <span>UrbanHazardMap</span>?</h1>

        <p>
            Заедно изграждаме по-безопасни градове.
            Подаваме сигнали, проследяваме опасностите и
            организираме доброволчески инициативи.
        </p>

        <a href="#steps" class="uhm-hero-button">
            Разбери как работи
            <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M7 17L17 7M7 7h10v10"/>
            </svg>
        </a>

        <div class="uhm-hero-decoration">
            <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 22s8-4.5 8-11V5l-8-3-8 3v6c0 6.5 8 11 8 11z"/>
                <path d="M9 12l2 2 4-4"/>
            </svg>
        </div>
    </div>
</section>

<!-- INTRODUCTION -->
<section class="uhm-intro container text-center">
    <span class="uhm-section-label">НАШАТА МИСИЯ</span>

    <h2>От сигнал до реална промяна</h2>

    <p>
        UrbanHazardMap свързва гражданите, институциите и доброволците
        в обща платформа за откриване, проследяване и разрешаване
        на проблеми в градската среда.
    </p>
</section>

<!-- HOW IT WORKS -->
<section class="uhm-steps-section" id="steps">
    <div class="container">

        <div class="uhm-section-heading text-center">
            <span class="uhm-section-label">ТРИ ЛЕСНИ СТЪПКИ</span>
            <h2>Как работи платформата?</h2>
            <p>Всеки може да допринесе за по-безопасна градска среда.</p>
        </div>

        <div class="row g-4 justify-content-center">

            <!-- STEP 1 -->
            <div class="col-12 col-md-6 col-lg-4">
                <article class="uhm-step-card h-100">

                    <div class="uhm-card-top">
                        <span class="uhm-step-number">01</span>

                        <div class="uhm-icon uhm-icon-red">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0z"/>
                                <circle cx="12" cy="10" r="2.5"/>
                            </svg>
                        </div>
                    </div>

                    <h3>Подай сигнал</h3>

                    <p>
                        Отбележи опасна сграда, повредена настилка,
                        неработещо съоръжение за достъпност или
                        замърсена площ директно върху интерактивната карта.
                        Добави геолокация и снимков материал.
                    </p>

                    <div class="uhm-card-footer">
                        <span class="uhm-dot red"></span>
                        Гражданско участие
                    </div>

                </article>
            </div>

            <!-- STEP 2 -->
            <div class="col-12 col-md-6 col-lg-4">
                <article class="uhm-step-card h-100">

                    <div class="uhm-card-top">
                        <span class="uhm-step-number">02</span>

                        <div class="uhm-icon uhm-icon-orange">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M3 21h18M5 21V7l7-4 7 4v14"/>
                                <path d="M9 21v-5h6v5"/>
                                <path d="M9 9h.01M15 9h.01M9 12h.01M15 12h.01"/>
                            </svg>
                        </div>
                    </div>

                    <h3>Институционална реакция</h3>

                    <p>
                        Сигналът се регистрира и се проследява от
                        отговорните институции. Следиш неговия статус
                        от подаването до разрешаването на проблема.
                    </p>

                    <div class="uhm-card-footer">
                        <span class="uhm-dot orange"></span>
                        Проследяване на сигнали
                    </div>

                </article>
            </div>

            <!-- STEP 3 -->
            <div class="col-12 col-md-6 col-lg-4">
                <article class="uhm-step-card h-100">

                    <div class="uhm-card-top">
                        <span class="uhm-step-number">03</span>

                        <div class="uhm-icon uhm-icon-green">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M16 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                                <circle cx="10" cy="7" r="4"/>
                                <path d="M20 8v6M17 11h6"/>
                            </svg>
                        </div>
                    </div>

                    <h3>Доброволческа общност</h3>

                    <p>
                        Когато е нужна гражданска намеса, организирай
                        или се присъедини към доброволческа инициатива
                        и действайте заедно за по-безопасна градска среда.
                    </p>

                    <div class="uhm-card-footer">
                        <span class="uhm-dot green"></span>
                        Съвместни инициативи
                    </div>

                </article>
            </div>

        </div>
    </div>
</section>

<!-- BOTTOM CALL TO ACTION -->
<section class="uhm-cta container">
    <div class="uhm-cta-content">
        <div>
            <span class="uhm-section-label">ЗАЕДНО СМЕ ПО-СИЛНИ</span>
            <h2>Промяната започва от теб.</h2>
            <p>
                Забеляза проблем в своя град? Не го подминавай.
                Всеки сигнал е стъпка към по-безопасна среда.
            </p>
        </div>

        <div class="uhm-cta-icon">
            <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 22s8-4.5 8-11V5l-8-3-8 3v6c0 6.5 8 11 8 11z"/>
                <path d="M9 12l2 2 4-4"/>
            </svg>
        </div>
    </div>
</section>
