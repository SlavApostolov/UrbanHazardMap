@using UrbanHazardMap.ViewModels
@model UrbanHazardMap.ViewModels.CreateIssueReportViewModel
@{
    ViewData["Title"] = "Report a Hazard";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm">
            <div class="card-body p-4">

                <h2 class="mb-1">Report a Hazard</h2>
                <p class="text-muted mb-4">Describe the problem and choose the categories it belongs to.</p>

                <form method="post">
                    <div class="mb-3">
                        <label for="Title" class="form-label">Title</label>
                        <input type="text" class="form-control" asp-for = "Title" placeholder="e.g. Large pothole on the main road" />
                    </div>
                    <div class="mb-3">
                        <label for="Description" class="form-label">Description</label>
                        <textarea class="form-control" asp-for = "Description" rows="4"></textarea>
                    </div>
                    <div class="row">
                        <div class="col-6 mb-3">
                            <label for="Latitude" class="form-label">Latitude</label>
                            <input type="number" step="any" class="form-control" asp-for="Latitude" readonly placeholder="Select on the map" />
                        </div>
                        <div class="col-6 mb-3">
                            <label for="Longitude" class="form-label">Longitude</label>
                            <input type="number" step="any" class="form-control" asp-for= "Longitude" readonly placeholder="Select on the map" />
                        </div>
                    </div>
                    <div class="form-text mb-3">Coordinates are filled in automatically when you pick a spot on the map.</div>
                    <div class="mb-3">
                        <label class="form-label d-block">Categories</label>

                        @foreach (CategoryOptionViewModel category in Model.AvailableCategories)
                        {
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="@category.Id" name="CategoryIds" value="@category.Id" />
                                <label class="form-check-label" for="@category.Id">@category.Title</label>
                            </div>
                        }
                    </div>
                    <button type="submit" class="btn btn-success w-100">Submit Report</button>
                </form>

            </div>
        </div>
    </div>
</div>