@using System.Globalization
@using UrbanHazardMap.ViewModels
@model AdminReportDetailsViewModel

@section Styles {
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
}

@{
    ViewData["Title"] = "Review Report";

    var status = Model.Status.ToString();
    var badgeClass = status switch
    {
        "Pending" => "bg-warning text-dark",
        "Approved" => "bg-success",
        "Rejected" => "bg-danger",
        _ => "bg-secondary"
    };
    var reporter = string.IsNullOrEmpty(Model.ReporterEmail) ? "Unknown" : Model.ReporterEmail;
}
<a asp-action="Index"
   asp-route-tab="@(Model.Status == "Approved" ? "approved" : "pending")"
   class="text-decoration-none">
    &larr; Back to reports
</a>

@if (TempData["Message"] is string message)
{
    <div class="alert alert-@(TempData["MessageType"] ?? "info") alert-dismissible fade show mt-3" role="alert">
        @message
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
<div class="row mt-3">
    <div class="col-lg-7 mb-4">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <h2 class="mb-0">@Model.Title</h2>
                    <span class="badge @badgeClass">@status</span>
                </div>

                <p class="text-muted mb-4">
                    Reported by @reporter on @Model.CreatedAt.ToString("yyyy-MM-dd HH:mm") UTC
                </p>

                <h5>Description</h5>
                <p class="report-description">@Model.Description</p>

@if (!string.IsNullOrWhiteSpace(Model.PhotoPath))
{
    <div class="mt-4">
        <h5>Attached Photo</h5>

        <img src="@Model.PhotoPath"
             alt="Photo attached to the hazard report"
             class="img-fluid rounded border"
             style="max-width: 100%; max-height: 400px; object-fit: contain;" />

        <p class="text-muted small mt-2">
            Please check that the photo does not contain
            identifiable faces or vehicle registration plates.
        </p>
    </div>
}

                <h5 class="mt-4">Categories and responsible institutions</h5>
                <ul class="list-group list-group-flush mb-4">
                    @foreach (var category in Model.Categories)
                    {
                        <li class="list-group-item px-0">
                            <span class="category-dot" style="background-color: @category.Color"></span><strong>@category.Title</strong>
                            <div class="text-muted small">Responsible institution: @category.InstitutionName</div>
                        </li>
                    }
                </ul>

                @if (status == "Pending")
                {
                    <div class="d-flex gap-2">
                        <form method="post" asp-action="Approve" asp-route-id="@Model.Id">
                            <button type="submit" class="btn btn-success">Approve</button>
                        </form>
                        <button type="button" class="btn btn-outline-danger" data-bs-toggle="collapse" data-bs-target="#rejectForm" aria-expanded="false" aria-controls="rejectForm">Reject</button>
                    </div>

                    <div class="collapse mt-3" id="rejectForm">
                        <form method="post" asp-action="Reject" asp-route-id="@Model.Id">
                            <label for="reason" class="form-label">Reason (optional)</label>
                            <textarea id="reason" name="reason" class="form-control mb-2" rows="3" maxlength="500" placeholder="Why is this report rejected?"></textarea>
                            <button type="submit" class="btn btn-danger">Confirm rejection</button>
                        </form>
                    </div>
                }
                else
                {
                    <div class="alert alert-secondary mb-0">
                        <div>This report was reviewed @(Model.ReviewedAt.HasValue ? "on " + Model.ReviewedAt.Value.ToString("yyyy-MM-dd HH:mm") + " UTC" : "earlier").</div>
                        @if (!string.IsNullOrEmpty(Model.RejectionReason))
                        {
                            <div class="mt-1"><strong>Reason:</strong> <span class="report-description">@Model.RejectionReason</span></div>
                        }
                    </div>
                }
            </div>
        </div>


<div class="card shadow-sm mt-4">
    <div class="card-body p-4">

        <h5 class="mb-3">
            <i class="bi bi-envelope-check me-2"></i>
            Institution Notifications
        </h5>

        @if (Model.Notifications == null || !Model.Notifications.Any())
        {
            <div class="alert alert-light border mb-0">
                <i class="bi bi-info-circle me-2"></i>
                No institution notifications have been sent yet.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Institution</th>
                            <th>Sent At (UTC)</th>
                            <th>Status</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var notification in Model.Notifications)
                        {
                            <tr>
                                <td>
                                    <strong>
                                        @notification.Institution?.Name
                                    </strong>
                                </td>

                                <td class="text-muted small">
                                    @notification.SentAt.ToUniversalTime().ToString("yyyy-MM-dd HH:mm:ss")
                                </td>

                                <td>
                                    @if (notification.IsSuccessful)
                                    {
                                        <span class="badge bg-success">
                                            <i class="bi bi-check-circle me-1"></i>
                                            OK
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">
                                            <i class="bi bi-x-circle me-1"></i>
                                            Failed
                                        </span>
                                    }
                                </td>
                            </tr>

                            @if (!notification.IsSuccessful &&
                                 !string.IsNullOrWhiteSpace(notification.Error))
                            {
                                <tr>
                                    <td colspan="3">
                                        <div class="alert alert-danger small mb-0">
                                            <strong>Error:</strong>
                                            @notification.Error
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

    </div>

    <div class="col-lg-5 mb-4">
        <div class="card shadow-sm">
            <div class="card-body p-2">
                <div id="detailsMap" class="admin-map"></div>
                <div class="text-muted small px-2 pt-2">
                    @Model.Latitude.ToString("0.000000", CultureInfo.InvariantCulture), @Model.Longitude.ToString("0.000000", CultureInfo.InvariantCulture)
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const position = [@Model.Latitude.ToString(CultureInfo.InvariantCulture), @Model.Longitude.ToString(CultureInfo.InvariantCulture)];
        const map = L.map('detailsMap', { scrollWheelZoom: false }).setView(position, 15);

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
        }).addTo(map);

        L.marker(position).addTo(map);
    </script>
}
